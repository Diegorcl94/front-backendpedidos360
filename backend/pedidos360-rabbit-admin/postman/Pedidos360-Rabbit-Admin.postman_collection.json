        "description": "Ejecutar manualmente. No se envían solicitudes adicionales desde los scripts.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"queue\": \"demo.evaluacion.queue\",\n  \"exchange\": \"demo.evaluacion.exchange\",\n  \"routingKey\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Cola duplicada - no modifica configuración",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/admin/queues",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Ejecutar manualmente. No se envían solicitudes adicionales desde los scripts.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"demo.evaluacion.queue\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Protección pedidos.dlq - debe rechazar",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/admin/queues/pedidos.dlq",
        "header": [],
